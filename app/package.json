    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tokens": "tsx scripts/gen-tokens.ts",
    "tokens:check": "tsx scripts/gen-tokens.ts --check",
    "contrast": "tsx scripts/check-contrast.ts",
    "test": "vitest run",
    "e2e": "playwright test",
    "tauri": "node scripts/tauri.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tauri-apps/api": "^2.12.4",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.57.0",
    "motion": "^14.3.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.14.5",
    "three": "^0.186.1",
    "uplot": "^1.6.32",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
